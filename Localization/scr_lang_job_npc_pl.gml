//For calling in Story Mode object only, call BEFORE NPC spawn scripts
//Language Array; 0 = English; 1 = Portuguese; 2 = Polish; 3 = Spanish; 4 = German; 5 = Russian
var lang_num = 2;

lang_npc[lang_num,0]  = "Łeh...?"                                                   //Bird Guard (Male)
lang_npc[lang_num,1]  = "..."                                                       //Bird Guard (Male)
lang_npc[lang_num,2]  = "Właśnie wysprzątałem stary poziom!"                          //Elric
lang_npc[lang_num,3]  = "Chcę abyś sprawdziła czy nadal trzyma się w jednej części!"              //Elric
lang_npc[lang_num,4]  = "Zlecono mi zbudowanie poziomu..."             //Uny (Female)
lang_npc[lang_num,5]  = "Ale nigdy wcześniej tego nie robiłam! Czy możesz mi pomóc?"            //Uny (Female)
lang_npc[lang_num,6]  = "Hej panno! Zbudowałam to wyzwanie..."                  //Stella
lang_npc[lang_num,7]  = "I wszyscy mówią mi że jest ono za trudne!"             //Stella
lang_npc[lang_num,8]  = "Jo! Jo! Jooo! Tutaj, ziomeczku!"                          //Lilac Eggplant
lang_npc[lang_num,9]  = "Zagraj w mój poziom, albo jesteś bakłażartem!"            //Lilac Eggplant
lang_npc[lang_num,10] = "Uwierzysz że pozwolili mi zbudować poziom?"              //Dark Libbie
lang_npc[lang_num,11] = "Spróbujesz go dla mnie?"                                  //Dark Libbie
lang_npc[lang_num,12] = "Tak, pracuję tutaj! I projektuje poziomy!"                   //Garrett
lang_npc[lang_num,13] = "Chciałabyś przetestować mój najnowszy?"                                //Garrett
lang_npc[lang_num,14] = "Pracowałem nad tym poziomem od miesięcy!"              //Pat (Male)
lang_npc[lang_num,15] = "Czy mogłabyś go dla mnie przetestować?"                    //Pat (Male)
lang_npc[lang_num,16] = "Moje raporty wskazują że Bouncer jest we Wschodniej Dzielnicy."       //Dr. Dean
lang_npc[lang_num,17] = "Nasz pociąg stojący od nas po lewej powinien pomóc ci w dotarciu na miejsce."     //Dr. Dean
lang_npc[lang_num,18] = "Ach! Dzień dobry uczennico!"                                //Dr. Dean
lang_npc[lang_num,19] = "Potrzebuję na moment twoich usług, jeśli można cię poprosić?"          //Dr. Dean
lang_npc[lang_num,20] = "Ach! Dobry wieczór uczennico!"                                //Dr. Dean
lang_npc[lang_num,21] = "DLATEGO NIE KARMI SIĘ MEW AAAAAAAAAAA"   //Astum
