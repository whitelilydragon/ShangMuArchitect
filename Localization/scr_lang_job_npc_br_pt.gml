var lang_num = 1;

lang_npc[lang_num,0]  = "Qua...?"                                                   //Bird Guard (Male)
lang_npc[lang_num,1]  = "..."                                                       //Bird Guard (Male)
lang_npc[lang_num,2]  = "Acabei de consertar esse estaǵio antigo!"                    //Elric
lang_npc[lang_num,3]  = "Preciso de você para ver se isso aguenta, literalmente!"   //Elric
lang_npc[lang_num,4]  = "Fui comissionada para designar um estágio, mas...            //Uny (Female)
lang_npc[lang_num,5]  = "Eu nunca fiz isso antes! Pode me ajudar?"                  //Uny (Female)
lang_npc[lang_num,6]  = "Olá, Senhorita cabra, eu fiz esse desafio..."              //Stella
lang_npc[lang_num,7]  = "E todo mundo diz para mim que é muito difícil!"            //Stella
lang_npc[lang_num,8]  = "Ora, Ora, Ora! Você aí, fracote!"                          //Lilac Eggplant
lang_npc[lang_num,9]  = "Jogue o meu estágio ou você é uma beringela podre!"        //Lilac Eggplant
lang_npc[lang_num,10] = "Você acredita que eles deixaram criar um estágio?"         //Dark Libbie
lang_npc[lang_num,11] = "Pode jogá-lo por mim?"                                     //Dark Libbie
lang_npc[lang_num,12] = "Sim, eu trabalho aqui! E eu crio estágios!"                //Garrett
lang_npc[lang_num,13] = "Quer experimentar a minha última criação?"                 //Garrett
lang_npc[lang_num,14] = "Estive trabalhando nesse estágio por meses!"               //Pat (Male)
lang_npc[lang_num,15] = "Poderia me ajudar a testá-lo?"                             //Pat (Male)
lang_npc[lang_num,16] = "Minhas análises sugerem que o Bouncer está no Distrito Leste" //Dr. Dean
lang_npc[lang_num,17] = "O trêm a nossa esquerda vai ajudá-la a chegar lá a tempo"  //Dr. Dean
lang_npc[lang_num,18] = "Ah! Bom dia, estudante!"                                   //Dr. Dean
lang_npc[lang_num,19] = "Estou necessitando os seus serviços, se tiver tempo disponível?" //Dr. Dean
lang_npc[lang_num,20] = "Ah! Boa noite, estudante!"                                 //Dr. Dean
